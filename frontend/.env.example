# Backend API URL
# Local Development: http://localhost:5050/api
# LAN HTTPS Access: https://172.20.10.2:5050/api (or through HTTPS reverse proxy)
VITE_API_URL=http://localhost:5050/api

# Optional Socket.IO URL (automatically inferred from VITE_API_URL if omitted)
# VITE_SOCKET_URL=https://172.20.10.2:5050

# Optional: Local HTTPS Development Certificates (for direct LAN mkcert testing)
# Generate with: mkcert -key-file certs/lan-key.pem -cert-file certs/lan-cert.pem localhost 127.0.0.1 <YOUR_LAN_IP>
VITE_HTTPS_CERT=./certs/lan-cert.pem
VITE_HTTPS_KEY=./certs/lan-key.pem
