generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ORGANIZER
  ATTENDEE
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

enum CheckInSource {
  ONLINE
  OFFLINE_SYNC
}

enum SyncResult {
  SUCCESS
  ALREADY_CHECKED_IN
  TOKEN_EXPIRED
  TOKEN_INVALID
  EVENT_CLOSED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ATTENDEE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  events        Event[]
  registrations Registration[]

  @@map("users")
}

model Event {
  id          String   @id @default(uuid())
  name        String
  date        DateTime @db.Timestamptz(6)
  capacity    Int
  organizerId String   @map("organizer_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organizer     User           @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@index([organizerId])
  @@map("events")
}

model Registration {
  id         String             @id @default(uuid())
  eventId    String             @map("event_id")
  attendeeId String             @map("attendee_id")
  status     RegistrationStatus @default(REGISTERED)
  createdAt  DateTime           @default(now()) @map("created_at")

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee   User       @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  qrToken    QrToken?
  checkIn    CheckIn?
  syncEvents SyncEvent[]

  @@unique([eventId, attendeeId])
  @@index([attendeeId])
  @@index([eventId])
  @@map("registrations")
}

model QrToken {
  id             String    @id @default(uuid())
  registrationId String    @unique @map("registration_id")
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("qr_tokens")
}

model CheckIn {
  id             String        @id @default(uuid())
  registrationId String        @unique @map("registration_id")
  checkedInAt    DateTime      @map("checked_in_at")
  source         CheckInSource
  createdAt      DateTime      @default(now()) @map("created_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  syncEvents   SyncEvent[]

  @@map("check_ins")
}

model SyncEvent {
  id             String     @id @default(uuid())
  deviceId       String     @map("device_id")
  clientScanId   String     @map("client_scan_id")
  registrationId String?    @map("registration_id")
  scannedAt      DateTime   @map("scanned_at")
  syncedAt       DateTime   @default(now()) @map("synced_at")
  result         SyncResult
  checkInId      String?    @map("check_in_id")

  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  checkIn      CheckIn?      @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  @@unique([deviceId, clientScanId])
  @@index([registrationId])
  @@index([checkInId])
  @@map("sync_events")
}